{
  "name": "powerplant-simulation",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && pnpm audit -P && vite build",
    "lint": "eslint . --fix && pnpm tsc -b --noEmit",
    "lint:ci": "eslint . && tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --project unit",
    "test:sim:golden": "vitest run --project golden",
    "test:sim:edge": "vitest run --project edge",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "depcheck": "knip",
    "sim": "tsx sim/run.ts",
    "sim:serve": "tsx sim/serve.ts",
    "sim:snapshots": "tsx sim/write-snapshots.ts",
    "sim:view": "pnpm sim && pnpm sim:serve",
    "roadmap": "tsx scripts/roadmap.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
